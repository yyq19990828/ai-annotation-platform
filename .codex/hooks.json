{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/session-start.mjs\"",
            "commandWindows": "node -e \"const{execFileSync,spawnSync}=require('node:child_process'),{join}=require('node:path');const root=execFileSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8'}).trim();const child=spawnSync(process.execPath,[join(root,'.codex','hooks','session-start.mjs')],{stdio:'inherit'});process.exit(child.status??1)\"",
            "timeout": 10,
            "statusMessage": "Collecting host hardware"
          }
        ]
      }
    ]
  }
}
