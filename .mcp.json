{
  "mcpServers": {
    "shadcn": {
      "command": "pnpm",
      "args": ["exec", "shadcn", "mcp"]
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "excalidraw": {
      "type": "http",
      "url": "https://mcp.excalidraw.com/mcp"
    }
  }
}
