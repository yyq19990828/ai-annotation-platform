FROM node:20-alpine AS build
WORKDIR /app
RUN apk add --no-cache bash
RUN corepack enable && corepack prepare pnpm@latest --activate
COPY pnpm-workspace.yaml package.json pnpm-lock.yaml ./
COPY apps/web/package.json apps/web/
COPY scripts/install-git-hooks.sh scripts/
RUN pnpm install --frozen-lockfile
COPY apps/api/openapi.snapshot.json apps/api/capability-registry.snapshot.json apps/api/
COPY apps/web apps/web
ARG VITE_EXPERIMENTAL_RASTER_MASK_WEBGPU=true
ENV VITE_EXPERIMENTAL_RASTER_MASK_WEBGPU=${VITE_EXPERIMENTAL_RASTER_MASK_WEBGPU}
ARG VITE_EXPERIMENTAL_LARGE_IMAGE_TILES=true
ENV VITE_EXPERIMENTAL_LARGE_IMAGE_TILES=${VITE_EXPERIMENTAL_LARGE_IMAGE_TILES}
RUN pnpm --filter @anno/web build

FROM nginx:alpine
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
COPY infra/docker/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
