{
  "name": "@anno/web",
  "private": true,
  "version": "0.21.12",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/codegen-if-changed.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . && node scripts/check-tw-tokens.mjs",
    "lint:css-tokens": "node scripts/check-tw-tokens.mjs",
    "lint:tw-tokens": "node scripts/check-tw-tokens.mjs",
    "typecheck": "tsc --noEmit",
    "codegen": "openapi-ts && node scripts/gen-capability-vocab.mjs",
    "codegen:watch": "openapi-ts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "screenshots": "playwright test --config=playwright.screenshots.config.ts --project=desktop-light",
    "screenshots:dark": "playwright test --config=playwright.screenshots.config.ts --project=desktop-dark",
    "screenshots:matrix": "playwright test --config=playwright.screenshots.config.ts --project=desktop-light --project=desktop-dark --project=tablet --project=mobile",
    "screenshots:flows": "playwright test --config=playwright.screenshots.config.ts --project=flows",
    "screenshots:regression": "playwright test --config=playwright.screenshots.config.ts --project=regression",
    "screenshots:lint": "node scripts/screenshots-lint.mjs",
    "size": "node scripts/check-bundle-size.mjs",
    "video:bench": "node scripts/video-bench/run-video-bench.mjs",
    "image:bench": "node scripts/image-bench/run-image-bench.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@sentry/react": "^8.45.0",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/react-query": "^5.60.0",
    "@tanstack/react-virtual": "^3.13.24",
    "@types/rbush": "^4.0.0",
    "@xyflow/react": "^12.11.1",
    "blurhash": "^2.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "html2canvas-pro": "^2.0.2",
    "idb-keyval": "^6.2.2",
    "konva": "^10.2.5",
    "lucide-react": "^1.14.0",
    "polygon-clipping": "^0.15.7",
    "radix-ui": "^1.6.0",
    "rbush": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-konva": "^18.2.14",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.28.0",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.2.4",
    "three": "^0.184.0",
    "tw-animate-css": "^1.4.0",
    "use-image": "^1.1.4",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@hey-api/openapi-ts": "^0.55.0",
    "@playwright/test": "^1.49.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.16.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.13.0",
    "jsdom": "^25.0.1",
    "msw": "^2.7.0",
    "typescript": "~5.6.0",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.9"
  }
}
